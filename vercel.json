{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/internal/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/docs/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    { "source": "/calculators/add-days", "destination": "/calculators/date-calculator/", "permanent": true },
    { "source": "/calculators/add-days/", "destination": "/calculators/date-calculator/", "permanent": true },
    { "source": "/calculators/subtract-days", "destination": "/calculators/date-calculator/", "permanent": true },
    { "source": "/calculators/subtract-days/", "destination": "/calculators/date-calculator/", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "header", "key": "x-forwarded-proto", "value": "http" }], "destination": "https://datepilot.online/$1", "permanent": true }
  ],
  "rewrites": []
}
